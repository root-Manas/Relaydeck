{
  "name": "relaydeck",
  "version": "1.0.0",
  "private": true,
  "description": "A Discord bot for routing feeds and updates into chosen channels.",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/bot.js",
    "dev": "node --watch --env-file-if-exists=.env src/bot.js",
    "preview": "node tools/preview-dashboard.js",
    "test": "node --test"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "fast-xml-parser": "^5.11.1"
  }
}
